# batch-anchor configuration. Copy to `batch-anchor.toml` and override
# only the fields you need — every field has a sensible local default
# (see `crates/batch-anchor/src/config.rs::Config::default`).

[delivery]
# nwaku REST endpoint. The infra/docker-compose.yml ships a node here.
url = "http://127.0.0.1:8645"
# Topics to subscribe to. Multiple = interop (e.g. consume chronicle's
# topic so this CLI anchors envelopes from both apps).
topics = [
    "/whistleblower/1/document-broadcast/json",
    # "/chronicle/1/document-index/json",
]
# Hours of store-protocol catch-up at startup. Higher = more resilient
# to outages, more pay-once cost at boot.
store_lookback_hours = 24

[storage]
# Codex / logos-storage REST endpoint.
url = "http://127.0.0.1:8080"

[registry]
# LEZ sequencer endpoint. lgs localnet defaults to :3040.
sequencer_url = "http://127.0.0.1:3040"
# Hex program_id printed by `wallet deploy-program`. 64 chars, no 0x.
program_id = ""
# SPEL IDL — generated by `spel generate-idl` and committed to ./idl/.
idl_path = "./idl/whistleblower_registry.json"
# Account that signs `init_registry` + `index_batch` submissions.
# Anyone can anchor; this is just whichever wallet account pays.
signer_account_id = ""
# Optional override if `lgs` is not on PATH.
# lgs_bin = "/usr/local/bin/lgs"

[batch]
# Maximum CIDs per `index_batch` transaction. Capped at MAX_BATCH (50).
flush_size = 50
# Or flush when this many seconds have passed since the last submission.
flush_interval_secs = 30
# Watch-loop poll cadence (seconds).
poll_interval_secs = 2
